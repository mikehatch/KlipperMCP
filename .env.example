# Multi-printer configuration
# Each printer uses PRINTER_<NAME>=<url> format
PRINTER_VORON=http://192.168.1.51:7125
PRINTER_ENDER=http://192.168.1.52:7125

# Optional: API keys per printer (if required)
# PRINTER_VORON_API_KEY=your-api-key
# PRINTER_ENDER_API_KEY=your-api-key

# Legacy single-printer mode (still supported)
# MOONRAKER_URL=http://192.168.1.51:7125
# MOONRAKER_API_KEY=

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
